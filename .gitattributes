# Lab core: identical in every lab repository; change it in
# vlmurthylab/project-template. Keep Unix line endings on scripts that git
# runs, so the PHI check works when checked out on Windows.
hooks/* text eol=lf
tools/*.pl text eol=lf
*.sh text eol=lf

# =============================================================================
# This repository: additions (keep the reason next to each rule)
# =============================================================================
# GitHub's language bar: the PTB-XL results notebook (with its plots) is larger
# than the Python package, so the repository showed as "Jupyter Notebook".
# Leave notebooks out of the language statistics; nothing else changes.
*.ipynb linguist-detectable=false
